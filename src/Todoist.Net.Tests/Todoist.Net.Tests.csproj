<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Todoist.Net" />
    <Using Include="Todoist.Net.Models" />
    <Using Include="Todoist.Net.Services" />
    <Using Include="Todoist.Net.Extensions" />
    <Using Include="Todoist.Net.Exceptions" />
    <Using Include="Todoist.Net.Tests.Helpers" />
    <Using Include="Todoist.Net.Tests.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Todoist.Net\Todoist.Net.csproj" />
  </ItemGroup>
</Project>
