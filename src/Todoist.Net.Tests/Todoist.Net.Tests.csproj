<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RunSettingsFilePath Condition="Exists('$(MSBuildProjectDirectory)\..\..\.runsettings')">$(MSBuildProjectDirectory)\..\..\.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Todoist.Net" />
    <Using Include="Todoist.Net.Models" />
    <Using Include="Todoist.Net.Services" />
    <Using Include="Todoist.Net.Extensions" />
    <Using Include="Todoist.Net.Exceptions" />
    <Using Include="Todoist.Net.Tests.Helpers" />
    <Using Include="Todoist.Net.Tests.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Todoist.Net\Todoist.Net.csproj" />
  </ItemGroup>
</Project>
